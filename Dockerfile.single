FROM rust:1.85
WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY src/ ./src/
COPY web/static/ ./web/static/
RUN cargo build --release --features api && mv target/release/world_generator .
RUN mkdir -p data
ENV RUST_LOG=info
ENV WORLD_FACTORY_PORT=8080
ENV WORLD_FACTORY_HOST=0.0.0.0
ENV WORLD_FACTORY_DATA_DIR=/data
EXPOSE 8080
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/app/world_generator", "--server", "--port", "8080"]
