FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates tini curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY world-factory-working /app/world-factory
RUN mkdir -p /data web/static
COPY web/static /app/web/static
RUN mkdir -p /data
ENV RUST_LOG=info
ENV WORLD_FACTORY_PORT=8080
ENV WORLD_FACTORY_HOST=0.0.0.0
ENV WORLD_FACTORY_DATA_DIR=/data
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 CMD curl -f http://localhost:8080/health || exit 1
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/app/world-factory", "--server", "--port", "8080"]
