FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates tini curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY target/release/world_generator /app/world_generator
RUN mkdir -p /data
ENV RUST_LOG=info
ENV WORLD_FACTORY_PORT=8080
ENV WORLD_FACTORY_HOST=0.0.0.0
ENV WORLD_FACTORY_DATA_DIR=/data
EXPOSE 8080
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/app/world_generator", "--server", "--port", "8080"]
