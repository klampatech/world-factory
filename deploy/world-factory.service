[Unit]
Description=World Factory API Server
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/world-factory
ExecStart=/home/deploy/world-factory/world_generator -s -p 8080
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=world-factory

# Health check - systemd watches the process
WatchdogSec=30

[Install]
WantedBy=multi-user.target
